rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check if user is the owner
    function isOwner(ownerField) {
      return request.auth != null && request.auth.uid == ownerField;
    }

    // Vendors: Public read, Admin or Owner write
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(resource.data.ownerId);
      allow create: if request.auth != null; 
    }

    // Events: Public read, Admin or Host write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner(resource.data.hostId);
      allow create: if request.auth != null;
    }

    // Blog Posts: Public read, Admin write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Marketing content: Public read, Admin write
    match /pricingTiers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /solutions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platformFeatures/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: User can read/write their own, Admin can do all
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // User profiles
    match /userProfiles/{userId} {
      allow read: if true; 
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Chats and Store Kits
    match /chats/{chatId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if resource.data.published == true || (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()));
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read: if get(/databases/$(database)/documents/chats/$(chatId)).data.published == true || 
                     (request.auth != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin()));
        allow write: if request.auth != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin());
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}