rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to marketing and dashboard content
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if false; // Only via Admin SDK/Console
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false; // Only via Admin SDK/Console
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if false; // Only via Admin SDK/Console
    }

    // User profiles - restricted to the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}