rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to check if user is the owner
    function isOwner(ownerField) {
      return isSignedIn() && request.auth.uid == ownerField;
    }

    function isSharedWithCurrentUser(data) {
      return isSignedIn() &&
             request.auth.token.email != null &&
             data.sharedWith is list &&
             request.auth.token.email in data.sharedWith;
    }

    function currentPeriodKey() {
      return request.time.year() * 100 + request.time.month();
    }

    function userPlan() {
      return (isSignedIn() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionPlan in ['free', 'pro', 'max', 'admin'])
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionPlan
        : 'free';
    }

    function messageLimit() {
      return (isAdmin() || userPlan() == 'admin')
        ? -1
        : (userPlan() == 'max' ? 1000 : (userPlan() == 'pro' ? 50 : 15));
    }

    function validUsageAfterIncrement(userId) {
      return existsAfter(/databases/$(database)/documents/messageUsage/$(userId)) &&
             getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.uid == request.auth.uid &&
             getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.periodKey == currentPeriodKey() &&
             getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.used is int &&
             (
               (!exists(/databases/$(database)/documents/messageUsage/$(userId)) &&
                getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.used == 1) ||
               (exists(/databases/$(database)/documents/messageUsage/$(userId)) &&
                get(/databases/$(database)/documents/messageUsage/$(userId)).data.periodKey == currentPeriodKey() &&
                getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.used ==
                  get(/databases/$(database)/documents/messageUsage/$(userId)).data.used + 1) ||
               (exists(/databases/$(database)/documents/messageUsage/$(userId)) &&
                get(/databases/$(database)/documents/messageUsage/$(userId)).data.periodKey != currentPeriodKey() &&
                getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.used == 1)
             ) &&
             (messageLimit() == -1 ||
              getAfter(/databases/$(database)/documents/messageUsage/$(userId)).data.used <= messageLimit());
    }

    // Vendors: Public read for marketplace pages.
    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAdmin() || (resource.data.ownerId != null && isOwner(resource.data.ownerId));
    }

    // Experiences: Public read, Admin write
    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events: Public read for public event pages.
    match /events/{eventId} {
      allow read: if (resource.data.isPublicBrief == true && resource.data.publicBriefStatus == 'open') ||
                   (resource.data.published == true) ||
                   isAdmin() ||
                   isOwner(resource.data.hostId) ||
                   isSharedWithCurrentUser(resource.data);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.hostId == request.auth.uid);
      allow update, delete: if isAdmin() || isOwner(resource.data.hostId);
    }

    // Blog Posts: Public read, Admin write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Marketing content: Public read, Admin write
    match /pricingTiers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /solutions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platformFeatures/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Insights: Public read, Admin write
    match /insights/{insightId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && userPlan() == 'admin');
    }

    // User profiles: User can read/write their own, Admin can do all
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.role in ['host', 'vendor'] &&
                    (
                      !('subscriptionPlan' in request.resource.data) ||
                      request.resource.data.subscriptionPlan == 'free'
                    );
      allow update: if isAdmin() ||
                    (isSignedIn() &&
                     request.auth.uid == userId &&
                     request.resource.data.uid == resource.data.uid &&
                     request.resource.data.role == resource.data.role &&
                     request.resource.data.subscriptionPlan == resource.data.subscriptionPlan);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // User settings/profile data
    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /messageUsage/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() &&
                            request.auth.uid == userId &&
                            request.resource.data.uid == request.auth.uid &&
                            request.resource.data.periodKey == currentPeriodKey() &&
                            request.resource.data.used is int &&
                            request.resource.data.used >= 1 &&
                            request.resource.data.plan in ['free', 'pro', 'max', 'admin'] &&
                            request.resource.data.limit is int &&
                            validUsageAfterIncrement(userId);
      allow delete: if false;
    }

    // Chats, Store Kits, and Vendor-Host Conversations
    match /chats/{chatId} {
      // Helper to check for participation
      function isParticipant() {
        return isSignedIn() && (
          request.auth.uid in resource.data.participants ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.hostId ||
          request.auth.uid == resource.data.vendorUid ||
          isAdmin()
        );
      }
      
      function willBeParticipant() {
        return isSignedIn() && (
          request.auth.uid in request.resource.data.participants ||
          request.auth.uid == request.resource.data.userId ||
          request.auth.uid == request.resource.data.hostId ||
          request.auth.uid == request.resource.data.vendorUid ||
          isAdmin()
        );
      }

      allow read: if resource.data.published == true || isParticipant();
      allow create: if willBeParticipant();
      allow update: if isParticipant();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.hostId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.vendorUid ||
          isAdmin()
        );
      }

      match /feedback/{feedbackId} {
        allow read, create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.hostId ||
          request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.vendorUid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
