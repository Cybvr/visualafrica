rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUpload() {
      return request.resource != null &&
             request.resource.contentType.matches('image/.*');
    }

    function withinUploadLimit(maxMb) {
      return request.resource.size <= maxMb * 1024 * 1024;
    }

    // Public-facing vendor images
    match /vendors/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUpload() && withinUploadLimit(8);
    }

    // Public store kit cover images
    match /store_covers/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImageUpload() && withinUploadLimit(8);
    }

    // Default deny for any other path
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
